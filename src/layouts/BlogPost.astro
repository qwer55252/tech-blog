---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { tagSlug, withBase } from '../utils/path';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, tags, series } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head><BaseHead title={`${title} · Sangheon.log`} description={description} image={heroImage ?? null} type="article" /></head>
	<body>
		<Header />
		<main class="post-shell">
			<article>
				<header class="post-head">
					<a class="back" href={withBase('/blog/')}>← 전체 글</a>
					{series && <p class="series">SERIES · {series}</p>}
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<div class="meta"><FormattedDate date={pubDate} />{updatedDate && <> · 수정 <FormattedDate date={updatedDate} /></>}</div>
					<div class="tags">{tags.map((tag) => <a href={withBase(`/tags/${tagSlug(tag)}/`)}>#{tag}</a>)}</div>
				</header>
				<div class="prose"><slot /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-shell { width: min(820px, calc(100% - 48px)); padding: clamp(3rem, 7vw, 6rem) 0; }
	.post-head { padding-bottom: 3rem; border-bottom: 1px solid var(--line); }
	.back { display: inline-block; margin-bottom: 3rem; color: var(--muted); font-size: .82rem; text-decoration: none; }
	.series { margin: 0 0 .8rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .14em; }
	h1 { margin: 0; font-size: clamp(2.4rem, 7vw, 4.7rem); letter-spacing: -.06em; line-height: 1.06; }
	.description { max-width: 680px; margin: 1.35rem 0; color: var(--muted); font-size: 1.05rem; }
	.meta { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .74rem; }
	.tags { display: flex; margin-top: .8rem; flex-wrap: wrap; gap: .7rem; }
	.tags a { font-size: .75rem; text-decoration: none; }
	.prose { padding-top: 3rem; }
	.prose :global(h2) { margin: 3rem 0 1rem; font-size: 1.75rem; letter-spacing: -.035em; }
	.prose :global(h3) { margin: 2.2rem 0 .8rem; font-size: 1.3rem; }
	.prose :global(p), .prose :global(li) { color: color-mix(in srgb, var(--text) 88%, var(--muted)); }
	.prose :global(p) { margin: 0 0 1.3rem; }
	.prose :global(li + li) { margin-top: .35rem; }
	@media (max-width: 720px) { .post-shell { width: min(100% - 32px, 820px); } }
</style>
