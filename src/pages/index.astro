---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/path';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const topics = ['Speech', 'ASR', 'Deep Learning', 'Paper Notes', 'ML Systems'];
---

<!doctype html>
<html lang="ko">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="kicker">LEARNING NOTES · AI & SPEECH</p>
				<h1>배우고, 실험하고,<br /><span>이해한 만큼 기록합니다.</span></h1>
				<p class="intro-copy">음성 인식과 딥러닝을 공부하며 만난 개념, 논문, 구현과 시행착오를 오래 남길 수 있는 글로 정리합니다.</p>
				<div class="topic-list" aria-label="주요 주제">
					{topics.map((topic) => <span>{topic}</span>)}
				</div>
			</section>

			<section class="recent">
				<div class="section-heading">
					<div><p class="section-label">RECENT NOTES</p><h2>최근 기록</h2></div>
					<a href={withBase('/blog/')}>전체 글 보기 →</a>
				</div>
				<div class="post-list">
					{posts.slice(0, 5).map((post, index) => (
						<article class="post-row">
							<span class="post-index">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<div class="post-meta"><FormattedDate date={post.data.pubDate} /> · {post.data.tags.join(' · ')}</div>
								<h3><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
							</div>
							<a class="post-arrow" href={withBase(`/blog/${post.id}/`)} aria-label={`${post.data.title} 읽기`}>↗</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { padding-top: 0; }
	.intro { padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6.5rem); border-bottom: 1px solid var(--line); }
	.kicker, .section-label { margin: 0 0 1.2rem; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: .16em; }
	h1 { max-width: 850px; margin: 0; font-size: clamp(2.8rem, 8vw, 6.5rem); letter-spacing: -.075em; line-height: .98; }
	h1 span { color: var(--muted); font-weight: 400; }
	.intro-copy { max-width: 620px; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.18rem); }
	.topic-list { display: flex; margin-top: 2.2rem; flex-wrap: wrap; gap: .55rem; }
	.topic-list span { padding: .42rem .72rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: .78rem; }
	.recent { padding: clamp(3.5rem, 7vw, 5.5rem) 0; }
	.section-heading { display: flex; margin-bottom: 1.2rem; align-items: end; justify-content: space-between; gap: 1rem; }
	.section-heading .section-label { margin-bottom: .35rem; }
	.section-heading h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: -.045em; }
	.section-heading > a { color: var(--muted); font-size: .85rem; text-decoration: none; }
	.post-row { display: grid; padding: 1.5rem 0; align-items: start; border-top: 1px solid var(--line); grid-template-columns: 3rem 1fr auto; gap: 1rem; }
	.post-index, .post-meta { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .72rem; }
	.post-row h3 { margin: .45rem 0 .35rem; font-size: clamp(1.22rem, 3vw, 1.7rem); letter-spacing: -.035em; }
	.post-row h3 a { color: var(--text); text-decoration: none; }
	.post-row p { max-width: 680px; margin: 0; color: var(--muted); font-size: .92rem; }
	.post-arrow { color: var(--muted); font-size: 1.15rem; text-decoration: none; }
	@media (max-width: 640px) { .post-row { grid-template-columns: 1.8rem 1fr; } .post-arrow { display: none; } }
</style>
